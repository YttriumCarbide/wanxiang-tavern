{
  "name": "wanxiang-tavern-demo",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.cjs",
    "start": "node server.cjs",
    "test": "node tools/test.mjs",
    "lint": "eslint .",
    "format": "prettier --write src tests tools styles *.html *.cjs *.mjs *.json *.md",
    "format:check": "prettier --check src tests tools styles *.html *.cjs *.mjs *.json *.md",
    "check": "node tools/test.mjs --scope quality,core",
    "test:baseline": "node tools/capture-layout.mjs",
    "audio:build": "node tools/build-audio.mjs",
    "build": "node tools/build-static.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "css-tree": "3.2.1",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "espree": "11.2.0",
    "globals": "17.13.0",
    "playwright": "1.64.1",
    "postcss": "8.5.30",
    "prettier": "3.9.10"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "js-tiktoken": "1.0.21"
  }
}
